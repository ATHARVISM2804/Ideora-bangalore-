{
  "name": "ideora-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "prebuild": "npm run check:links && npm run sitemap",
    "sitemap": "node scripts/build-sitemap.mjs",
    "check:links": "node scripts/check-links.mjs",
    "test": "playwright test",
    "test:visual": "playwright test --project=visual",
    "test:browsers": "playwright test --project=chromium --project=firefox --project=webkit --project=mobile-safari --project=mobile-chrome",
    "test:update": "playwright test --project=visual --update-snapshots"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "web-vitals": "^6.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2"
  }
}
